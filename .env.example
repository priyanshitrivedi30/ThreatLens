# ── ThreatLens v3.0 — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in the values you want to enable.
# All variables are optional — the dashboard works without any of them.

# AbuseIPDB  (https://www.abuseipdb.com/api)
# Enriches flagged IPs with community abuse confidence scores.
ABUSEIPDB_KEY=

# Slack alerting  (https://api.slack.com/messaging/webhooks)
# Sends a rich message to a Slack channel when a new CRITICAL IP is detected.
SLACK_WEBHOOK_URL=

# Email alerting  (uses SMTP with STARTTLS)
ALERT_EMAIL_TO=you@example.com
ALERT_EMAIL_FROM=threatlens@example.com
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=your-gmail@gmail.com
ALERT_SMTP_PASS=your-app-password   # use a Gmail App Password, not your account password

# Alert threshold — how many attempts before an alert fires (default: 20)
ALERT_THRESHOLD=20
